{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm run build:api",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "data/sample-extrato.csv",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
