# fake = planner heuristico, roda offline, sem custo (padrao)
# openai = planner via LLM (com fallback automatico se houver chave secundaria)
PLANNER=fake

# Provedor primario
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Provedor secundario (opcional): usado se o primario falhar (rate limit, timeout, erro)
# Exemplos gratuitos: Groq, Gemini, OpenRouter
OPENAI_API_KEY_2=
OPENAI_BASE_URL_2=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL_2=gemini-3.1-flash-lite

# Tempo maximo de cada chamada ao LLM, em milissegundos (padrao 15000)
PLANNER_TIMEOUT_MS=15000

# ---------- deploy (container) ----------

# HOST=0.0.0.0 dentro do container, para o proxy alcançar a API (local: loopback)
# HOST=

# Domínios públicos aceitos no Host/Origin (comma-separated), ex.: app.onrender.com
# PUBLIC_HOSTS=

# Senha do HTTP Basic para o deploy. Vazio = sem senha (só seguro em loopback)
# APP_PASSWORD=

# Usuário do HTTP Basic (padrão: extrato)
# APP_USER=extrato

# Se o primario e o secundario falharem, cai automaticamente para o heuristico (offline).
